# ─── AccountantAI — Backend environment ───────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit real secrets (this example file is NOT gitignored).

# App
APP_NAME=AccountantAI Backend
APP_ENV=development
DEBUG=true

# Supabase (from Supabase dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard → Settings → API → JWT Secret (used to verify access tokens)
SUPABASE_JWT_SECRET=

# Google Gemini (from Google AI Studio)
GEMINI_API_KEY=

# CORS (JSON array of origins allowed to call the API)
CORS_ORIGINS=["http://localhost:3000"]

# WhatsApp Business (Meta Cloud API). Global — one platform Meta App + WABA
# shared by all accountants (Model A). See docs/sdd/010-whatsapp-adapter.md.
# - WHATSAPP_VERIFY_TOKEN: any string YOU choose. Entered when subscribing the
#   webhook in Meta for Developers; used for the GET challenge handshake.
# - WHATSAPP_APP_SECRET: Meta for Developers -> Your App -> Settings -> Basic.
#   Used to verify X-Hub-Signature-256 on the webhook POST.
# - WHATSAPP_ACCESS_TOKEN: system-user token with whatsapp_business_messaging /
#   whatsapp_business_management permissions (Business Manager -> System Users).
# - WHATSAPP_BUSINESS_ACCOUNT_ID: the platform WABA id (all numbers share it).
# - WHATSAPP_PHONE_NUMBER_ID: default/test number; accountants link their own
#   phone_number_id via `whatsapp_connections`.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

#WHATSAPP API tokens
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=