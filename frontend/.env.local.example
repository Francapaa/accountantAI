# ─── AccountantAI — Frontend environment ───────────────────────────────
# Copy this file to `.env.local` and fill in your values.
# NEVER commit real secrets.

# Site / SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contacto@accountantai.com

# Analytics (privacy-first, Plausible). Leave empty to disable.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Supabase (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API (FastAPI). Used by server-side calls to /api/* endpoints.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
