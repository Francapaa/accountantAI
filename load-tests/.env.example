# AccountantAI load-tests: environment variables
# k6 reads these from __ENV. Pass them with `--env NAME=value` per run.
#
# Example:
#   npm run smoke -- --env BASE_URL=http://127.0.0.1:8000 \
#     --env SUPABASE_JWT_SECRET=xxx --env SUB_USER_ID=xxx
#
# EASIER: copy this file to `.env` and fill the values once. run.mjs loads
# `.env` automatically and passes it to k6, so plain `npm run smoke` works.
# CLI `--env` flags still override `.env` values.
#
#   cp .env.example .env

# --- Target app ---
BASE_URL=http://127.0.0.1:8000

# --- Auth (protected endpoints) ---
# A Supabase JWT is signed inside k6. The backend verifies it against
# SUPABASE_JWT_SECRET (set in backend/.env). SUB_USER_ID is the `sub` claim and
# must own the fixture rows (connections/conversations/clients) for write endpoints.
SUPABASE_JWT_SECRET=
SUB_USER_ID=00000000-0000-0000-0000-000000000001

# --- Fixture ids (anchor rows owned by SUB_USER_ID) ---
# Required to exercise the happy path of write endpoints against real data.
CONVERSATION_ID=
CONNECTION_ID=
APPROVE_DRAFT_ID=

# --- WhatsApp webhook ---
# Same values configured in backend/.env
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Load profiles (ramping-vus) ---
LOAD_START_VUS=1
LOAD_PEAK_VUS=10
LOAD_STAGE_S=60

# --- Optional overrides ---
# K6_BIN: path to the k6 executable when it is not on PATH (defaults to `k6`)